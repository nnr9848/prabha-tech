# =========================================================
# PrabhaTech Environment Configuration for VPS Deployment
# =========================================================

# The local host port PrabhaTech binds to (change if 3005 is occupied by another site)
APP_PORT=3005

# Database Settings
POSTGRES_DB=uxda_db
POSTGRES_USER=prabhatech_user
POSTGRES_PASSWORD=ChangeThisToAStrongPassword123!

# JWT Secret (Generate with: openssl rand -hex 32)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970

# CORS Allowed Domains (Add your VPS domain)
CORS_ALLOWED_ORIGINS=https://yourdomain.com,http://localhost:3005
